---
import HeadingTitles from '../Heading-Titles/Heading-Titles.astro';
import './reception.css'
import './../Horarios/horarios.css'
---

<HeadingTitles heading="Recepción y Horarios" />
<section class="reception container">
	<div class="horarios_cards">
		<section class="card">
			<h3>Ceremonia Civil <br/> Playa Cerritos</h3>
			<p>4:50pm</p>
			<address class="reception_address">
				<p>Playas de Mazatlán por cárcamo de cerritos, entre Quintas del Mar y Villas del Mar</p>
				<p class="reception_address__italics">Mazatlán, Sinaloa, MX</p>
			</address>
		</section>

		<section class="card">
			<h3>Recepción Cena <br/> Finca Buenos Aires</h3>
			<p>7:30pm</p>
			<address class="reception_address">
				<p>Cedros 19206, Fraccionamiento Pradera Dorada, CP 82136</p>
				<p class="reception_address__italics">Mazatlán, Sinaloa, MX</p>
			</address>
		</section>
	</div>

	<section class="reception_map">
		<iframe src="https://www.google.com/maps/d/embed?mid=1zyiDVdwWATuSM5wU5sgX6gBsk9nkF18&ehbc=2E312F" width="100%" height="480"></iframe>
	</section>
	<section class="dressing_code">
		<h3>Regla de etiqueta:</h3>
		<p>Mujeres: Vestido largo. Prohibido vestir color rojo, blanco, negro y plata; eviten negar acceso.</p>
		<p>Hombres: Vestimenta Formal.</p>
	</section>
</section>