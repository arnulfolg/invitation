---

import Timer from '../Timer/Timer';
import HeroTitle from './HeroTitle.astro';
import './hero.css'
---

<header class="hero">
	<section class="hero_picture">
		<img class="feature_image" src="images/hero.jpeg" alt="">
		<!-- <h1 class="container">Oyuky & Daniel</h1> -->
		<HeroTitle />
	</section>
	<section class="hero_date container">
		<p class="hero_date_heading" >Sé parte de nuestra historia de amor.</p>
		<section class="hero_date_text">
			<p class="save_the_date">
				<span class="save_the_date_day">Martes </span>
				<span class="save_the_date_number text_bold">23 </span> 
				<span class="save_the_date_text_1">de </span>
				<span class="save_the_date_month text_bold">Diciembre</span>
			</p>
			<p class="save_the_date_year">del 2025</p>
		</section>
		<picture class="hero_image">
			<img class="hero_image__front" src="/icons/ring.svg"></i>
		</picture>
		<Timer client:only="react" />
	</section>
</header>